# ============================================
# AI Recruit Pro - Environment Variables
# ============================================
# Copy file ini menjadi .env lalu isi nilainya
# cp .env.example .env

# --- App ---
APP_NAME=AI Recruit Pro
APP_VERSION=0.1.0
DEBUG=True

# --- Database ---
# Opsi 1 (MySQL di Hosting / cPanel / VPS):
# DATABASE_URL=mysql+aiomysql://username:password@localhost:3306/nama_database
# Opsi 2 (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/airecruitpro

# --- JWT Auth ---
SECRET_KEY=ganti-dengan-secret-key-yang-panjang-dan-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Model ---
SBERT_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
CV_THRESHOLD_DEFAULT=40.0
INTERVIEW_THRESHOLD_DEFAULT=40.0

# --- CORS (Domain Frontend Anda di Hosting) ---
FRONTEND_URL=http://localhost:3000

# --- Cloud Media Storage (Cloudflare R2 - Direkomendasikan: $0 Egress/Bandwidth Gratis) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=airecruitpro
R2_PUBLIC_URL=https://pub-your_id.r2.dev

# --- Cloud Media Storage (Cloudinary - Cadangan/Fallback) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Supabase Storage (Opsional) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key
